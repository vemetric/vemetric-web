{
  "name": "@vemetric/web",
  "repository": {
    "type": "git",
    "url": "https://github.com/vemetric/vemetric-web.git"
  },
  "homepage": "https://vemetric.com/docs/sdks/javascript",
  "version": "0.7.0",
  "description": "Official Web (Browser) SDK for Vemetric",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublish": "pnpm run build",
    "build": "tsdown && node after-build.mjs",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings=0 . --fix",
    "publish-cdn": "npm run build && node publish-cdn.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "new-version": "node new-version.mjs",
    "dev-cdn": "http-server ./dist -p 3786",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "typescript",
    "browser",
    "sdk",
    "web",
    "vemetric"
  ],
  "author": "Vemetric <info@vemetric.com> (https://vemetric.com/)",
  "license": "MIT",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.27.1"
}
