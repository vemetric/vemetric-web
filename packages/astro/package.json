{
  "name": "@vemetric/astro",
  "repository": {
    "type": "git",
    "url": "https://github.com/vemetric/vemetric-web.git"
  },
  "homepage": "https://vemetric.com/docs/sdks/astro",
  "version": "0.6.3",
  "description": "Official Astro SDK for Vemetric",
  "exports": {
    ".": {
      "import": "./dist/component.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublish": "pnpm run build",
    "build": "tsdown && pnpm copy-astro",
    "copy-astro": "cp src/component.ts dist/ && cp src/index.astro dist/",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings=0 . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "typescript",
    "astro",
    "sdk",
    "web",
    "vemetric"
  ],
  "author": "Vemetric <info@vemetric.com> (https://vemetric.com/)",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
