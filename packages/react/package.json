{
  "name": "@vemetric/react",
  "repository": {
    "type": "git",
    "url": "https://github.com/vemetric/vemetric-web.git"
  },
  "homepage": "https://vemetric.com/docs/sdks/react",
  "version": "0.6.3",
  "description": "Official React SDK for Vemetric",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
